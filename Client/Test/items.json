{
  "role": "Client",
  "include": [
    "login.json"
  ],
  "fixture": [
    {
      "sql": "UPDATE TBL_STDITEM SET FLD_AC=2,FLD_AC2=5,FLD_MAC=1,FLD_MAC2=3 WHERE FLD_INDEX=33"
    },
    {
      "sql": "INSERT INTO TBL_CHARACTER_ITEM (FLD_LOGINID,FLD_CHARNAME,FLD_STDTYPE,FLD_MAKEDATE,FLD_MAKEINDEX,FLD_STDINDEX,FLD_DURA,FLD_DURAMAX) VALUES ('mirtest','MirProbe01','B','261118','00001',33,5000,5000)"
    },
    {
      "sql": "UPDATE TBL_STDITEM_ETC SET FLD_NAME='Test potion',FLD_VAL1=10 WHERE FLD_INDEX=0"
    },
    {
      "sql": "INSERT INTO TBL_CHARACTER_GENITEM VALUES ('mirtest','MirProbe01','G00080008000')"
    }
  ],
  "cases": [
    {
      "name": "dismiss arrival",
      "request": {
        "jsonrpc": "2.0",
        "id": "dismiss arrival",
        "method": "notice.dismiss",
        "params": {}
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "items ready",
      "await_state": {
        "input_delayed": false,
        "notice": false,
        "bag.0.id": 1,
        "bag.1.id": 2
      }
    },
    {
      "name": "wrong equipment slot rejected",
      "request": {
        "jsonrpc": "2.0",
        "id": "wrong slot",
        "method": "item.equip",
        "params": {
          "id": 1,
          "slot": 1
        }
      },
      "expect": {
        "error.code": -32002
      }
    },
    {
      "name": "rejected equipment preserves inventory",
      "request": {
        "jsonrpc": "2.0",
        "id": "preserved",
        "method": "state.get"
      },
      "expect": {
        "result.bag.0.id": 1,
        "result.bag.1.id": 2,
        "result.held_item": null,
        "result.equipment": []
      }
    },
    {
      "name": "unowned item rejected",
      "request": {
        "jsonrpc": "2.0",
        "id": "unowned",
        "method": "item.use",
        "params": {
          "id": 999
        }
      },
      "expect": {
        "error.code": -32002
      }
    },
    {
      "name": "equip armor",
      "request": {
        "jsonrpc": "2.0",
        "id": "equip armor",
        "method": "item.equip",
        "params": {
          "id": 1,
          "slot": 0
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "armor equipped",
      "await_state": {
        "dress": 1,
        "defence": [
          2,
          5
        ],
        "magic_defence": [
          1,
          3
        ],
        "equipment_pending": 0,
        "equipment.0.id": 1,
        "held_item": null
      }
    },
    {
      "name": "unequip armor",
      "request": {
        "jsonrpc": "2.0",
        "id": "unequip armor",
        "method": "item.unequip",
        "params": {
          "slot": 0
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "armor returned",
      "await_state": {
        "dress": 0,
        "defence": [
          0,
          0
        ],
        "equipment": [],
        "equipment_pending": 0,
        "bag.0.id": 1,
        "held_item": null
      }
    },
    {
      "name": "drop potion",
      "request": {
        "jsonrpc": "2.0",
        "id": "drop potion",
        "method": "item.drop",
        "params": {
          "id": 2
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "potion on ground",
      "await_state": {
        "drop_pending": false,
        "ground_items.0.name": "Test potion",
        "ground_items.0.x": 459,
        "ground_items.0.y": 261
      }
    },
    {
      "name": "pickup potion",
      "request": {
        "jsonrpc": "2.0",
        "id": "pickup potion",
        "method": "item.pickup",
        "params": {}
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "potion recovered",
      "await_state": {
        "ground_items": [],
        "bag.1.id": 2,
        "bag.1.name": "Test potion"
      }
    },
    {
      "name": "consume recovered potion",
      "request": {
        "jsonrpc": "2.0",
        "id": "consume recovered potion",
        "method": "item.use",
        "params": {
          "id": 2
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "potion consumed",
      "await_state": {
        "ground_items": [],
        "use_pending": false,
        "held_item": null,
        "bag.0.id": 1
      }
    },
    {
      "name": "drop armor",
      "request": {
        "jsonrpc": "2.0",
        "id": "drop armor",
        "method": "item.drop",
        "params": {
          "id": 1
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "armor on ground",
      "await_state": {
        "bag": [],
        "drop_pending": false,
        "ground_items.0.name": "Test male armor"
      }
    },
    {
      "name": "pickup armor",
      "request": {
        "jsonrpc": "2.0",
        "id": "pickup armor",
        "method": "item.pickup",
        "params": {}
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "armor recovered",
      "await_state": {
        "ground_items": [],
        "bag.0.id": 1,
        "bag.0.name": "Test male armor"
      }
    },
    {
      "name": "equip again",
      "request": {
        "jsonrpc": "2.0",
        "id": "equip again",
        "method": "item.equip",
        "params": {
          "id": 1,
          "slot": 0
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "final equipment",
      "await_state": {
        "bag": [],
        "equipment.0.id": 1,
        "equipment_pending": 0,
        "dress": 1,
        "defence": [
          2,
          5
        ],
        "hp": 18,
        "mp": 13
      }
    },
    {
      "name": "return to selection",
      "request": {
        "jsonrpc": "2.0",
        "id": "return to selection",
        "method": "session.return",
        "params": {}
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "selection after saving",
      "await_state": {
        "scene": "character_select",
        "waiting": false,
        "notice": false
      }
    },
    {
      "name": "reenter saved character",
      "request": {
        "jsonrpc": "2.0",
        "id": "reenter saved character",
        "method": "session.enter",
        "params": {
          "name": "MirProbe01"
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "restored inventory",
      "await_state": {
        "scene": "world",
        "map": "01",
        "bag": [],
        "equipment.0.name": "Test male armor",
        "dress": 1,
        "defence": [
          2,
          5
        ],
        "magic_defence": [
          1,
          3
        ]
      }
    }
  ],
  "database_expect": [
    {
      "name": "consumed potion not saved",
      "sql": "SELECT COUNT(*) FROM TBL_CHARACTER_GENITEM WHERE FLD_CHARNAME='MirProbe01'",
      "rows": [
        [
          0
        ]
      ]
    },
    {
      "name": "exactly one recovered armor saved",
      "sql": "SELECT COUNT(*) FROM TBL_CHARACTER_ITEM WHERE FLD_CHARNAME='MirProbe01' AND FLD_STDINDEX=33",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "name": "equipped armor persisted",
      "sql": "SELECT FLD_DRESS_ID FROM TBL_CHARACTER WHERE FLD_CHARNAME='MirProbe01'",
      "rows": [
        [
          "B26111800001"
        ]
      ]
    }
  ]
}
