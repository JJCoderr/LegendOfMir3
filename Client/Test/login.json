{
  "role": "Client",
  "cases": [
    {
      "name": "credentials ready",
      "await_state": {
        "scene": "login",
        "stage": "credentials",
        "connected": true
      }
    },
    {
      "name": "wrong password",
      "request": {
        "jsonrpc": "2.0",
        "id": "wrong password",
        "method": "session.login",
        "params": {
          "account": "mirtest",
          "password": "wrong"
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "login rejected",
      "await_state": {
        "scene": "login",
        "stage": "credentials",
        "notice": true
      }
    },
    {
      "name": "dismiss rejection",
      "request": {
        "jsonrpc": "2.0",
        "id": "dismiss rejection",
        "method": "notice.dismiss"
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "login",
      "request": {
        "jsonrpc": "2.0",
        "id": "login",
        "method": "session.login",
        "params": {
          "account": "mirtest",
          "password": "test123"
        }
      },
      "expect": {
        "result.status": "submitted"
      }
    },
    {
      "name": "authenticated",
      "await_state": {
        "scene": "login",
        "stage": "server_list",
        "notice": true
      }
    },
    {
