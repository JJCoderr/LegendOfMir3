        "method": "session.select_server",
        "params": {
          "name": "MissingServer"
        }
      },
      "expect": {
        "error.code": -32002
      }
    },
    {
      "name": "select server",
      "request": {
        "jsonrpc": "2.0",
        "id": "select server",
        "method": "session.select_server",
        "params": {
          "name": "Mir3Local"
