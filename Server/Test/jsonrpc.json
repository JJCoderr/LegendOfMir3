{
  "role": "Server",
  "cases": [
    {
      "name": "state",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "state.get"
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result.schema": 1
      }
    },
    {
      "name": "unknown method",
      "request": {
        "jsonrpc": "2.0",
        "id": "未知",
        "method": "missing"
      },
      "expect": {
        "id": "未知",
        "error.code": -32601
      }
    },
    {
      "name": "invalid params",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "state.get",
        "params": 3
      },
      "expect": {
        "id": 3,
        "error.code": -32602
      }
    },
    {
      "name": "invalid request",
      "request": {
        "id": 4,
        "method": "state.get"
      },
      "expect": {
        "id": null,
        "error.code": -32600
      }
    },
    {
      "name": "parse error",
      "raw": "{",
      "expect": {
        "id": null,
        "error.code": -32700
      }
    },
    {
      "name": "batch notification",
      "request": [
        {
          "jsonrpc": "2.0",
          "method": "state.get"
        },
        {
          "jsonrpc": "2.0",
          "id": 6,
          "method": "state.get"
        }
      ],
      "expect": {
        "0.id": 6,
        "0.result.schema": 1
      }
    }
  ]
}
