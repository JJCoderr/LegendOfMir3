/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\ManConsole.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 69
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,21
    LTEXT           "Legend of Mir II - Administrator Management Console",
                    IDC_STATIC,45,16,177,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2002 Wemade Entertainment",IDC_STATIC,45,
                    31,143,8
    DEFPUSHBUTTON   "OK",IDOK,178,48,50,14,WS_GROUP
END

IDD_MANCONSOLE_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Legend Of Mir II - Administrator Management Console"
FONT 9, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,207,179,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,263,179,50,14
    CONTROL         "List1",IDC_LIST1,"SysListView32",LVS_REPORT | WS_BORDER | 
                    WS_TABSTOP,7,7,306,129
    EDITTEXT        IDC_EDIT1,7,147,306,14,ES_AUTOHSCROLL
END


