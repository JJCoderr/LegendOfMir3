IDD_CONFIGDLG DIALOG DISCARDABLE  0, 0, 187, 143
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Database Server Configuration"
FONT 9, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,71,122,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,130,122,50,14
    CONTROL         "IPAddress1",IDC_DBMS_IP,"SysIPAddress32",WS_TABSTOP,65,
                    29,90,11
    EDITTEXT        IDC_DBMS_PORT,65,43,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Address :",-1,29,31,35,8
    GROUPBOX        "DBMS Information",-1,15,15,158,83
    LTEXT           "Instance :",-1,28,45,34,9
    LTEXT           "ID : ",-1,30,81,14,8
    EDITTEXT        IDC_DBMS_ID,46,78,28,14,ES_AUTOHSCROLL
    LTEXT           "Password :",-1,82,81,38,8
    EDITTEXT        IDC_DBMS_PASSWORD,123,78,40,14,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    LTEXT           "Database :",-1,25,60,36,8
